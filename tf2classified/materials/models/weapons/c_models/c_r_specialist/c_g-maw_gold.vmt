"VertexLitGeneric"
{
	"$basetexture"	"models\weapons\c_models\c_g-maw\c_g-maw_gold"

                // Begin GOLD look

	"$envmap" "cubemaps/cubemap_gold001.hdr"	
	"$envmaptint" "[2.5 2.5 1.15]"
	
	// End GOLD look
	
	"$phong" "1"
	"$phongexponent" "15"
	"$phongboost" "3"	
	"$lightwarptexture" "models/lightwarps/weapon_lightwarp"
	"$phongfresnelranges"	"[.3 .5 3]"
	"$halflambert" "1"
	"$glowcolor" "1"

	"$tempvar" "0"

	"$basephongexponent" "15"
	"$basephongboost" "3"

	"$basemapalphaphongmask" "1"
	
	"$rimlight" "1"						
	"$rimlightexponent" "20"				
	"$rimlightboost" ".25"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

}